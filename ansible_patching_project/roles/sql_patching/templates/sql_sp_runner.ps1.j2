# Auto-generated SQL SP patch runner
$ErrorActionPreference = "Continue"

$logDir = "{{ sql_patch_log_dir }}"
if (!(Test-Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory | Out-Null
}

$logFile = Join-Path $logDir ("SQL_SP_" + (Get-Date -Format yyyyMMdd_HHmmss) + ".log")
"=== Starting SQL SP patch run at $(Get-Date) ===" | Out-File $logFile

$patches = {{ sql_sp_patches | default([]) | to_json }}
foreach ($patch in $patches) {
    "Applying SP patch: $patch" | Out-File $logFile -Append

    Start-Process $patch -ArgumentList "/q /action=patch /allinstances /IAcceptSQLServerLicenseTerms" -Wait

    "Finished SP patch: $patch (ExitCode=$LASTEXITCODE)" | Out-File $logFile -Append
}

"=== Completed SQL SP patch run at $(Get-Date) ===" | Out-File $logFile -Append
